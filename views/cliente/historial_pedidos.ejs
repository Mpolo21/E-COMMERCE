<%- include('../partials/header') %>

<div class="card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; margin-bottom:28px;">
  <div>
    <h2 style="margin-bottom:6px;">Mi Cuenta</h2>
    <p style="margin:3px 0;"><strong>Cliente:</strong> <%= cliente.nombre %> (<%= cliente.correo %>)</p>
    <p style="margin:3px 0;"><strong>Dirección registrada:</strong> <%= cliente.direccion || 'No especificada' %></p>
    <p style="margin:8px 0 0 0; font-size:0.86rem; color:var(--text-secondary);">
      <strong>Regla del Programa:</strong> Ganas 1 punto por cada <%= formatoCOP(configPuntos.copPorPuntoGanado) %> efectivamente pagados y cada punto vale <%= formatoCOP(configPuntos.valorPuntoCop) %> de descuento en tus compras.
    </p>
  </div>
  <div style="background: var(--accent-soft); border: 1px solid #e5d5b5; padding: 18px 24px; border-radius: var(--radius-md); text-align: center; min-width: 240px;">
    <span style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-secondary); font-weight:600;">Saldo de Fidelización</span>
    <h3 style="margin:6px 0 2px 0; font-size:2rem; color:var(--accent);"><%= cliente.puntos_fidelizacion.toLocaleString('es-CO') %> pts</h3>
    <strong style="color:var(--success-text); font-size:0.95rem;">Equivalen a <%= formatoCOP(equivalenciaPesos) %></strong>
  </div>
</div>

<!-- Historial de Pedidos -->
<h3>Historial de Pedidos y Estado de Pago / Entrega</h3>
<% if (pedidos.length === 0) { %>
  <div class="card" style="text-align:center; margin-bottom:30px;">
    <p>Aún no has realizado compras en nuestra tienda.</p>
    <a href="/catalogo" class="btn-accent">Explorar Catálogo</a>
  </div>
<% } else { %>
  <div class="table-responsive" style="margin-bottom:35px;">
    <table>
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Fecha</th>
          <th>Subtotal</th>
          <th>Descuento Puntos</th>
          <th>Total a Pagar</th>
          <th>Puntos Ganados</th>
          <th>Método y Estado Pago</th>
          <th>Entrega</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <% pedidos.forEach(ped => { %>
          <tr>
            <td><strong>#<%= ped.id_pedido %></strong></td>
            <td><%= new Date(ped.fecha_pedido).toLocaleDateString('es-CO') %></td>
            <td><%= formatoCOP(ped.subtotal) %></td>
            <td style="color:var(--success-text);">
              <% if (ped.puntos_canjeados > 0) { %>
                - <%= formatoCOP(ped.descuento_puntos) %> (<%= ped.puntos_canjeados %> pts)
              <% } else { %>
                $ 0
              <% } %>
            </td>
            <td><strong><%= formatoCOP(ped.total) %></strong></td>
            <td style="color:var(--accent); font-weight:600;">+<%= ped.puntos_ganados %> pts</td>
            <td>
              <span class="badge-estado <%= ped.estado_pedido.toLowerCase() %>"><%= ped.estado_pedido %></span><br>
              <small style="color:var(--text-muted);"><%= ped.metodo_pago %></small>
            </td>
            <td>
              <span class="badge-estado <%= ped.estado_entrega === 'Entregado' ? 'entregado' : (ped.estado_entrega === 'Despachado' ? 'despachado' : 'en-preparacion') %>">
                <%= ped.estado_entrega %>
              </span><br>
              <small style="color:var(--text-muted);"><%= ped.tipo_entrega %> <%= ped.transportadora ? '('+ped.transportadora+')' : '' %></small>
            </td>
            <td>
              <a href="/cuenta/pedidos/<%= ped.id_pedido %>" class="btn-sm">Ver Detalle</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<!-- Tabla de Movimientos de Puntos (Ajuste 4.6) -->
<h3>Historial de Movimientos de Puntos</h3>
<% if (!movimientos || movimientos.length === 0) { %>
  <div class="card">
    <p style="margin:0; color:var(--text-secondary);">Aún no registras movimientos de puntos en tu cuenta.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Tipo</th>
          <th>Puntos</th>
          <th>Saldo Resultante</th>
          <th>Pedido Relacionado</th>
          <th>Descripción</th>
        </tr>
      </thead>
      <tbody>
        <% movimientos.forEach(mov => { %>
          <tr>
            <td><%= new Date(mov.fecha).toLocaleString('es-CO') %></td>
            <td>
              <span class="badge-estado <%= mov.tipo.toLowerCase() %>"><%= mov.tipo %></span>
            </td>
            <td style="font-weight:700; color:<%= mov.puntos >= 0 ? 'var(--success-text)' : 'var(--danger-text)' %>;">
              <%= mov.puntos > 0 ? '+' + mov.puntos.toLocaleString('es-CO') : mov.puntos.toLocaleString('es-CO') %> pts
            </td>
            <td><strong><%= mov.saldo_resultante.toLocaleString('es-CO') %> pts</strong></td>
            <td>
              <% if (mov.id_pedido) { %>
                <a href="/cuenta/pedidos/<%= mov.id_pedido %>">Pedido #<%= mov.id_pedido %></a>
              <% } else { %>
                —
              <% } %>
            </td>
            <td><%= mov.descripcion %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>