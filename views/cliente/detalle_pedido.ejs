<%- include('../partials/header') %>

<div class="container" style="max-width: 800px; margin-top: 30px;">
  <div style="background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <h2>Detalle del Pedido #<%= pedido.id_pedido %></h2>
    <p><strong>Fecha:</strong> <%= new Date(pedido.fecha_pedido).toLocaleString() %></p>
    <p><strong>Dirección de Entrega:</strong> <%= pedido.direccion_entrega %></p>
    <p><strong>Método de Pago:</strong> <%= pedido.nombre_metodo %></p>
    <p><strong>Estado del Pedido:</strong> <span class="badge-estado <%= pedido.estado_pedido.toLowerCase() %>"><%= pedido.estado_pedido %></span></p>
    <p><strong>Logística de Entrega:</strong> <%= pedido.tipo_entrega %> — <strong>Estado Entrega:</strong> <%= pedido.estado_entrega %> <%= pedido.transportadora ? '('+pedido.transportadora+')' : '' %></p>

    <h3 style="margin-top: 25px;">Prendas Adquiridas</h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
      <thead>
        <tr style="background: #f1f5f9; text-align: left;">
          <th style="padding: 10px;">Producto</th>
          <th style="padding: 10px;">Talla / Color</th>
          <th style="padding: 10px;">Cantidad</th>
          <th style="padding: 10px;">Precio Unitario</th>
          <th style="padding: 10px;">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% pedido.detalles.forEach(det => { %>
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 10px;"><strong><%= det.nombre_producto %></strong></td>
            <td style="padding: 10px;">Talla: <%= det.nombre_talla %> / Color: <%= det.nombre_color %></td>
            <td style="padding: 10px;"><%= det.cantidad %></td>
            <td style="padding: 10px;">$ <%= Number(det.precio_unitario).toLocaleString('es-CO') %></td>
            <td style="padding: 10px; font-weight: bold; color: #16a34a;">$ <%= (det.cantidad * det.precio_unitario).toLocaleString('es-CO') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div style="margin-top: 20px; text-align: right;">
      <h3>Total Pagado: <span style="color: #16a34a;">$ <%= Number(pedido.total).toLocaleString('es-CO') %> COP</span></h3>
    </div>

    <div style="margin-top: 30px;">
      <a href="/cuenta/pedidos" class="btn-secondary-link" style="width: auto; display: inline-block;">← Volver al Historial</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>