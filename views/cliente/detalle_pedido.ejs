<%- include('../partials/header') %>

<div style="max-width: 850px; margin: 0 auto;">
  <div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:15px;">
      <h2 style="margin:0;">Detalle del Pedido #<%= pedido.id_pedido %></h2>
      <span class="badge-estado <%= pedido.estado_pedido.toLowerCase() %>">Estado Pago: <%= pedido.estado_pedido %></span>
    </div>

    <p><strong>Fecha:</strong> <%= new Date(pedido.fecha_pedido).toLocaleString('es-CO') %></p>
    <p><strong>Dirección de Entrega:</strong> <%= pedido.direccion_entrega %></p>
    <p><strong>Método de Pago:</strong> <%= pedido.nombre_metodo %></p>
    <p><strong>Logística de Entrega:</strong> <%= pedido.tipo_entrega %> — <strong>Estado Entrega:</strong> <%= pedido.estado_entrega %> <%= pedido.transportadora ? '('+pedido.transportadora+')' : '' %></p>

    <h3 style="margin-top: 25px;">Prendas Adquiridas</h3>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Talla / Color</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% pedido.detalles.forEach(det => { %>
            <tr>
              <td><strong><%= det.nombre_producto %></strong></td>
              <td>Talla: <%= det.nombre_talla %> / Color: <%= det.nombre_color %></td>
              <td><%= det.cantidad %></td>
              <td><%= formatoCOP(det.precio_unitario) %></td>
              <td><strong><%= formatoCOP(det.cantidad * det.precio_unitario) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div style="margin-top: 20px; background: var(--bg-muted); padding: 18px; border-radius: var(--radius-md); text-align: right;">
      <p style="margin:4px 0;">Subtotal: <strong><%= formatoCOP(pedido.subtotal) %></strong></p>
      <p style="margin:4px 0; color:var(--success-text);">Descuento por Puntos (<%= pedido.puntos_canjeados %> pts): <strong>- <%= formatoCOP(pedido.descuento_puntos) %></strong></p>
      <h3 style="margin:8px 0 4px 0; color:var(--accent);">Total Final: <%= formatoCOP(pedido.total) %></h3>
      <small style="color:var(--text-secondary);">Puntos ganados en esta orden: <strong>+<%= pedido.puntos_ganados %> pts</strong></small>
    </div>

    <div style="margin-top: 20px;">
      <a href="/cuenta/pedidos" class="btn-sm">← Volver a Mi Cuenta</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>