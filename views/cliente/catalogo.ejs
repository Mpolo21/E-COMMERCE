<%- include('../partials/header') %>

<div class="catalogo-wrapper">
  <aside class="filtros-sidebar">
    <h3>Filtrar Colección</h3>
    <form action="/catalogo" method="GET">
      <div class="form-group">
        <label for="categoria">Categoría</label>
        <select name="categoria" id="categoria">
          <option value="">Todas las categorías</option>
          <% filtrosDisponibles.categorias.forEach(cat => { %>
            <option value="<%= cat.id_categoria %>" <%= filtrosActivos.categoria == cat.id_categoria ? 'selected' : '' %>><%= cat.nombre_categoria %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="marca">Marca</label>
        <select name="marca" id="marca">
          <option value="">Todas las marcas</option>
          <% filtrosDisponibles.marcas.forEach(mar => { %>
            <option value="<%= mar.id_marca %>" <%= filtrosActivos.marca == mar.id_marca ? 'selected' : '' %>><%= mar.nombre_marca %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="talla">Talla</label>
        <select name="talla" id="talla">
          <option value="">Todas las tallas</option>
          <% filtrosDisponibles.tallas.forEach(tal => { %>
            <option value="<%= tal.id_talla %>" <%= filtrosActivos.talla == tal.id_talla ? 'selected' : '' %>><%= tal.nombre_talla %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="color">Color</label>
        <select name="color" id="color">
          <option value="">Todos los colores</option>
          <% filtrosDisponibles.colores.forEach(col => { %>
            <option value="<%= col.id_color %>" <%= filtrosActivos.color == col.id_color ? 'selected' : '' %>><%= col.nombre_color %></option>
          <% }) %>
        </select>
      </div>

      <button type="submit" class="btn-primary">Aplicar Filtros</button>
      <a href="/catalogo" class="btn-secondary-link">Limpiar Filtros</a>
    </form>
  </aside>

  <section class="productos-grid-container">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <h2 style="margin:0;">Colección Masculina</h2>
      <span style="color:var(--text-muted); font-size:0.9rem;"><%= productos.length %> prenda(s) encontrada(s)</span>
    </div>

    <% if (productos.length === 0) { %>
      <div class="card" style="margin-top: 20px; text-align: center; padding: 45px 25px;">
        <h3>No encontramos prendas con esos criterios</h3>
        <p style="color:var(--text-secondary);">Prueba limpiando los filtros o seleccionando otra categoría o talla.</p>
        <a href="/catalogo" class="btn-accent" style="margin-top:10px;">Ver todo el catálogo</a>
      </div>
    <% } else { %>
      <div class="productos-grid">
        <% productos.forEach(prod => { %>
          <article class="producto-card">
            <div>
              <div class="producto-img-placeholder" role="img" aria-label="Imagen ilustrativa de <%= prod.nombre_producto %>">
                <span class="placeholder-cat"><%= prod.nombre_categoria %></span>
                <span class="placeholder-brand"><%= prod.nombre_marca %></span>
              </div>
              <div class="producto-header-badge">
                <span class="badge-marca"><%= prod.nombre_marca %></span>
                <span class="badge-temporada"><%= prod.nombre_temporada %></span>
              </div>
              <h3 style="font-size:1.1rem; margin:6px 0;"><%= prod.nombre_producto %></h3>
              <p class="precio"><%= formatoCOP(prod.precio) %></p>
            </div>

            <div>
              <div style="margin-bottom: 14px; display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.84rem; color:var(--text-secondary);">Stock: <strong><%= prod.stock_total %></strong></span>
                <% if (prod.stock_total <= 0) { %>
                  <span class="badge badge-danger">Agotado</span>
                <% } else if (prod.stock_total <= 5) { %>
                  <span class="badge badge-warning">Pocas unidades</span>
                <% } else { %>
                  <span class="badge badge-success">Disponible</span>
                <% } %>
              </div>
              <a href="/catalogo/producto/<%= prod.id_producto %>" class="btn-primary">Ver Detalle / Comprar</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>