<%- include('../partials/header') %>

<div style="max-width: 960px; margin: 0 auto;">
  <h2>Tu Carrito de Compras</h2>

  <% if (typeof hayDadosDeBaja !== 'undefined' && hayDadosDeBaja) { %>
    <div class="alert alert-danger">
      <span><strong>Atención:</strong> Una o más prendas de tu carrito fueron dadas de baja del catálogo. Por favor elimínalas del carrito para poder proceder al checkout.</span>
    </div>
  <% } %>

  <% if (carrito.length === 0) { %>
    <div class="card" style="text-align:center; padding:40px 20px;">
      <p>Tu carrito está vacío actualmente.</p>
      <a href="/catalogo" class="btn-accent">Explorar el Catálogo</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Talla / Color</th>
            <th>Precio Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% carrito.forEach(item => { %>
            <tr style="<%= item.dado_de_baja ? 'background:#fef2f2; opacity:0.85;' : '' %>">
              <td>
                <strong><%= item.nombre_producto %></strong>
                <% if (item.dado_de_baja) { %>
                  <br><span class="badge badge-danger">No disponible (Dado de baja)</span>
                <% } %>
              </td>
              <td>Talla: <%= item.nombre_talla %> / Color: <%= item.nombre_color %></td>
              <td><%= formatoCOP(item.precio) %></td>
              <td>
                <% if (item.dado_de_baja) { %>
                  <span style="color:var(--danger-text); font-size:0.85rem;">Retirar del carrito</span>
                <% } else { %>
                  <form action="/carrito/modificar" method="POST" style="display:inline;">
                    <input type="hidden" name="id_inventario" value="<%= item.id_inventario %>">
                    <button type="submit" name="accion" value="disminuir" class="btn-sm">-</button>
                  </form>
                  <span style="margin: 0 10px; font-weight: bold;"><%= item.cantidad %></span>
                  <form action="/carrito/modificar" method="POST" style="display:inline;">
                    <input type="hidden" name="id_inventario" value="<%= item.id_inventario %>">
                    <button type="submit" name="accion" value="aumentar" class="btn-sm">+</button>
                  </form>
                <% } %>
              </td>
              <td style="font-weight: bold;">
                <%= item.dado_de_baja ? '—' : formatoCOP(item.precio * item.cantidad) %>
              </td>
              <td>
                <form action="/carrito/modificar" method="POST">
                  <input type="hidden" name="id_inventario" value="<%= item.id_inventario %>">
                  <button type="submit" name="accion" value="eliminar" class="btn-danger-sm">Quitar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card" style="margin-top: 25px; text-align: right;">
      <h3>Total Estimado: <span style="color: var(--accent);"><%= formatoCOP(total) %></span></h3>
      <div style="margin-top: 15px; display:flex; justify-content:flex-end; gap:12px; flex-wrap:wrap;">
        <a href="/catalogo" class="btn-sm" style="padding:11px 18px;">← Seguir Comprando</a>
        <% if (typeof hayDadosDeBaja !== 'undefined' && hayDadosDeBaja) { %>
          <button type="button" class="btn-primary" style="width:auto; background:#9ca3af; cursor:not-allowed;" disabled>
            Retira las prendas dadas de baja para pagar
          </button>
        <% } else { %>
          <a href="/carrito/checkout" class="btn-primary" style="width: auto;">Proceder al Checkout →</a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>