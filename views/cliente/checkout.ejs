<%- include('../partials/header') %>

<div style="max-width: 820px; margin: 0 auto;">
  <h2>Finalizar Compra (Checkout)</h2>

  <div class="card">
    <form action="/carrito/checkout" method="POST" id="form-checkout">
      <div class="form-group">
        <label for="direccion_entrega">Dirección Exacta de Entrega *</label>
        <input type="text" id="direccion_entrega" name="direccion_entrega" required value="<%= direccionCliente %>" placeholder="Ej: Carrera 103 # 98-15 Barrio Vélez, Apartadó">
      </div>

      <!-- Sección de Canje de Puntos de Fidelización (Ajuste 4.3) -->
      <div style="background: var(--accent-soft); border: 1px solid #e5d5b5; padding: 18px; border-radius: var(--radius-md); margin: 22px 0;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
          <div>
            <h4 style="margin:0 0 4px 0;">Programa de Puntos PIJIC Menswear</h4>
            <p style="margin:0; font-size:0.9rem; color:var(--text-secondary);">
              Tienes <strong><%= saldoPuntos.toLocaleString('es-CO') %> puntos</strong> disponibles = <strong><%= formatoCOP(equivalenciaPesos) %></strong> de descuento.
            </p>
            <small style="color:var(--text-muted);">
              Regla vigente: Ganas 1 punto por cada <%= formatoCOP(configPuntos.copPorPuntoGanado) %> pagados y cada punto vale <%= formatoCOP(configPuntos.valorPuntoCop) %>.
            </small>
          </div>
          <% if (puntosMaximos > 0) { %>
            <label style="display:flex; align-items:center; gap:8px; font-weight:700; cursor:pointer;">
              <input type="checkbox" id="usar_puntos" name="usar_puntos" value="1" style="width:18px; height:18px;">
              Usar mis puntos
            </label>
          <% } else { %>
            <span class="badge badge-warning">Sin puntos disponibles para canjear</span>
          <% } %>
        </div>

        <% if (puntosMaximos > 0) { %>
          <div id="panel-canje" style="display:none; margin-top:15px; padding-top:15px; border-top:1px dashed #d6c39c;">
            <div style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
              <div class="form-group" style="margin:0; flex:1; min-width:200px;">
                <label for="puntos_a_canjear">Puntos a canjear (Máximo aplicable: <%= puntosMaximos.toLocaleString('es-CO') %> pts)</label>
                <input type="number" id="puntos_a_canjear" name="puntos_a_canjear" value="0" min="0" max="<%= puntosMaximos %>" step="1">
              </div>
              <button type="button" id="btn-max-puntos" class="btn-accent" style="padding:10px 16px;">
                Usar el máximo posible (<%= puntosMaximos.toLocaleString('es-CO') %> pts)
              </button>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Selector de Método de Pago -->
      <div class="form-group" id="bloque-metodo-pago">
        <label for="id_metodo_pago">Método de Pago *</label>
        <select name="id_metodo_pago" id="id_metodo_pago" required>
          <% metodosPago.forEach(metodo => { %>
            <option value="<%= metodo.id_metodo %>"><%= metodo.nombre_metodo %></option>
          <% }) %>
        </select>
        <small style="color:var(--text-muted); display:block; margin-top:5px;">
          * Si eliges <strong>Pago Contraentrega</strong>, tu pedido quedará en estado <em>Debiendo</em> y los puntos se acreditarán cuando el administrador confirme el pago al entregar.
        </small>
      </div>

      <div id="aviso-pago-cero" class="alert alert-success" style="display:none;">
        ¡Tus puntos cubren el 100% del pedido! No necesitas método de pago adicional y tu pedido quedará Pagado de inmediato.
      </div>

      <!-- Resumen Financiero Destacado -->
      <div style="background: var(--bg-muted); padding: 20px; border-radius: var(--radius-md); margin: 22px 0;">
        <h3 style="margin-bottom:12px;">Resumen del Pedido (<%= carrito.reduce((a, b) => a + b.cantidad, 0) %> prendas)</h3>
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <span>Subtotal Prendas:</span>
          <strong id="lbl-subtotal"><%= formatoCOP(subtotal) %></strong>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:8px; color:var(--success-text);">
          <span>Descuento por Puntos:</span>
          <strong id="lbl-descuento">- $ 0</strong>
        </div>
        <div style="display:flex; justify-content:space-between; padding-top:10px; border-top:1px solid var(--border-color); font-size:1.3rem;">
          <strong>Total Final a Pagar:</strong>
          <strong id="lbl-total" style="color:var(--accent);"><%= formatoCOP(subtotal) %></strong>
        </div>
      </div>

      <button type="submit" class="btn-primary" style="font-size:1.05rem; padding:14px;">Confirmar Compra</button>
      <a href="/carrito" class="btn-secondary-link">← Volver al Carrito</a>
    </form>
  </div>
</div>

<script>
  (function() {
    const subtotal = <%= Number(subtotal) || 0 %>;
    const valorPunto = <%= Number(configPuntos.valorPuntoCop) || 1 %>;
    const puntosMax = <%= Number(puntosMaximos) || 0 %>;

    const chkUsar = document.getElementById('usar_puntos');
    const panelCanje = document.getElementById('panel-canje');
    const inputPuntos = document.getElementById('puntos_a_canjear');
    const btnMax = document.getElementById('btn-max-puntos');
    const lblDescuento = document.getElementById('lbl-descuento');
    const lblTotal = document.getElementById('lbl-total');
    const bloqueMetodo = document.getElementById('bloque-metodo-pago');
    const avisoPagoCero = document.getElementById('aviso-pago-cero');

    const fmt = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });

    function recalcular() {
      if (!chkUsar || !chkUsar.checked) {
        if (inputPuntos) inputPuntos.value = 0;
        lblDescuento.textContent = '- ' + fmt.format(0);
        lblTotal.textContent = fmt.format(subtotal);
        bloqueMetodo.style.display = 'block';
        avisoPagoCero.style.display = 'none';
        return;
      }

      let pts = parseInt(inputPuntos.value, 10) || 0;
      if (pts < 0) pts = 0;
      if (pts > puntosMax) pts = puntosMax;

      const descuento = Math.min(subtotal, pts * valorPunto);
      const total = Math.max(0, subtotal - descuento);

      lblDescuento.textContent = '- ' + fmt.format(descuento);
      lblTotal.textContent = fmt.format(total);

      if (total === 0) {
        bloqueMetodo.style.display = 'none';
        avisoPagoCero.style.display = 'block';
      } else {
        bloqueMetodo.style.display = 'block';
        avisoPagoCero.style.display = 'none';
      }
    }

    if (chkUsar) {
      chkUsar.addEventListener('change', function() {
        panelCanje.style.display = this.checked ? 'block' : 'none';
        if (!this.checked && inputPuntos) inputPuntos.value = 0;
        recalcular();
      });
    }

    if (inputPuntos) {
      inputPuntos.addEventListener('input', recalcular);
    }

    if (btnMax) {
      btnMax.addEventListener('click', function() {
        inputPuntos.value = puntosMax;
        recalcular();
      });
    }
  })();
</script>

<%- include('../partials/footer') %>