<%- include('../partials/header') %>

<div style="max-width: 1140px; margin: 0 auto;">
  <!-- Encabezado Corporativo del Proveedor -->
  <div class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 28px; border-left: 5px solid var(--accent);">
    <div>
      <span class="badge-marca">Módulo CU03 - Solo Lectura</span>
      <h2 style="margin: 8px 0 5px 0;"><%= proveedor.nombre_proveedor %></h2>
      <p style="margin: 2px 0; color: var(--text-secondary);">
        <strong>Teléfono:</strong> <%= proveedor.telefono || 'No registrado' %> |
        <strong>Correo Corporativo:</strong> <%= proveedor.correo || 'No registrado' %>
      </p>
    </div>
    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
      <div class="kpi-card" style="padding: 14px 20px; text-align: center; min-width: 160px;">
        <span class="kpi-label">Prendas Suministradas</span>
        <div class="kpi-value" style="font-size: 1.7rem; margin: 4px 0 0 0;"><%= productosSuministrados.length %></div>
      </div>
      <div class="kpi-card" style="padding: 14px 20px; text-align: center; min-width: 160px; background: var(--accent-soft);">
        <span class="kpi-label">Órdenes de Compra</span>
        <div class="kpi-value" style="font-size: 1.7rem; margin: 4px 0 0 0; color: var(--accent);"><%= comprasRealizadas.length %></div>
      </div>
    </div>
  </div>

  <!-- 1. Productos que suministra a la empresa -->
  <div class="card" style="margin-bottom: 28px;">
    <h3>1. Productos que Suministra a la Tienda</h3>
    <% if (productosSuministrados.length === 0) { %>
      <p style="color: var(--text-secondary);">Aún no tienes productos vinculados en el catálogo.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Producto</th>
              <th>Categoría / Marca</th>
              <th>Temporada</th>
              <th>Costo Promedio</th>
              <th>Stock Actual en Tienda</th>
              <th>Estado en Catálogo</th>
            </tr>
          </thead>
          <tbody>
            <% productosSuministrados.forEach(p => { %>
              <% const estadoClase = p.estado ? 'pagado' : 'cancelado'; %>
              <% const estadoTexto = p.estado ? 'Activo' : 'Dado de baja'; %>
              <tr style="<%= !p.estado ? 'background:#fef2f2;' : '' %>">
                <td><strong>#<%= p.id_producto %></strong></td>
                <td><strong><%= p.nombre_producto %></strong></td>
                <td><%= p.nombre_categoria %> — <%= p.nombre_marca %></td>
                <td><%= p.nombre_temporada %></td>
                <td><%= formatoCOP(p.costo_promedio_ponderado) %></td>
                <td style="font-weight: bold;"><%= p.stock_actual_tienda %> unids.</td>
                <td>
                  <span class="badge-estado <%= estadoClase %>"><%= estadoTexto %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- 2. Órdenes de Compra realizadas por la empresa y estado -->
  <div class="card" style="margin-bottom: 28px;">
    <h3>2. Compras Realizadas por la Empresa y Estado de Órdenes</h3>
    <% if (comprasRealizadas.length === 0) { %>
      <p style="color: var(--text-secondary);">La tienda aún no registra órdenes de compra para tu empresa.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Orden de Compra</th>
              <th>Fecha Solicitud</th>
              <th>Referencias</th>
              <th>Total Unidades Solicitadas</th>
              <th>Valor Total Orden</th>
              <th>Estado de la Compra</th>
            </tr>
          </thead>
          <tbody>
            <% comprasRealizadas.forEach(c => { %>
              <% const claseCompra = c.estado_compra === 'Recibida' ? 'pagado' : (c.estado_compra === 'Solicitada' ? 'pendiente' : 'cancelado'); %>
              <tr>
                <td><strong>#<%= c.id_compra %></strong></td>
                <td><%= new Date(c.fecha_compra).toLocaleString('es-CO') %></td>
                <td><%= c.referencias_incluidas %> ítem(s)</td>
                <td style="font-weight: bold;"><%= c.total_unidades_solicitadas %> unids.</td>
                <td style="font-weight: bold; color: var(--success-text);"><%= formatoCOP(c.total_compra) %></td>
                <td>
                  <span class="badge-estado <%= claseCompra %>"><%= c.estado_compra %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- 3. Historial detallado de suministros (cantidades por talla y color) -->
  <div class="card">
    <h3>3. Historial Detallado de Suministros y Cantidades Solicitadas</h3>
    <% if (historialSuministros.length === 0) { %>
      <p style="color: var(--text-secondary);">No hay detalles de suministros registrados.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Orden #</th>
              <th>Fecha</th>
              <th>Producto Suministrado</th>
              <th>Talla / Color</th>
              <th>Cant. Solicitada</th>
              <th>Precio Compra Unitario</th>
              <th>Subtotal</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            <% historialSuministros.forEach(h => { %>
              <tr>
                <td><strong>#<%= h.id_compra %></strong></td>
                <td><%= new Date(h.fecha_compra).toLocaleDateString('es-CO') %></td>
                <td><strong><%= h.nombre_producto %></strong></td>
                <td>Talla: <%= h.nombre_talla %> / Color: <%= h.nombre_color %></td>
                <td style="font-weight: bold;"><%= h.cantidad_solicitada %> unids.</td>
                <td><%= formatoCOP(h.precio_compra_unitario) %></td>
                <td style="font-weight: bold; color: var(--success-text);"><%= formatoCOP(h.subtotal_suministro) %></td>
                <td>
                  <span class="badge-estado <%= h.estado_compra === 'Recibida' ? 'pagado' : 'pendiente' %>"><%= h.estado_compra %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>