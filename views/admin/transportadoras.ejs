<%- include('../partials/header') %>
<%- include('../partials/admin_nav') %>

<h2>CU02.6 - Gestión de Empresas Transportadoras</h2>
<div style="display:flex; gap:25px; flex-wrap:wrap; margin-top:20px;">
  <div style="flex:1; min-width:280px; background:#fff; padding:20px; border-radius:8px;">
    <h3>Agregar Transportadora</h3>
    <form action="/admin/transportadoras/crear" method="POST">
      <div class="form-group">
        <label>Nombre de la Empresa *</label>
        <input type="text" name="nombre_empresa" required placeholder="Ej: Envía Colvanes">
      </div>
      <div class="form-group">
        <label>Teléfono</label>
        <input type="text" name="telefono">
      </div>
      <div class="form-group">
        <label>Correo de Contacto</label>
        <input type="email" name="correo">
      </div>
      <button type="submit" class="btn-primary">Guardar Transportadora</button>
    </form>
  </div>

  <div style="flex:2; min-width:340px; background:#fff; padding:20px; border-radius:8px;">
    <h3>Transportadoras Aliadas</h3>
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="background:#1e293b; color:#fff; text-align:left;">
          <th style="padding:10px;">Empresa</th>
          <th style="padding:10px;">Teléfono</th>
          <th style="padding:10px;">Correo</th>
          <th style="padding:10px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% transportadoras.forEach(tr => { %>
          <tr style="border-bottom:1px solid #e2e8f0;">
            <form action="/admin/transportadoras/actualizar" method="POST">
              <td style="padding:10px;">
                <input type="hidden" name="id_transportadora" value="<%= tr.id_transportadora %>">
                <input type="text" name="nombre_empresa" value="<%= tr.nombre_empresa %>" required style="padding:5px; width:100%;">
              </td>
              <td style="padding:10px;"><input type="text" name="telefono" value="<%= tr.telefono %>" style="padding:5px; width:100%;"></td>
              <td style="padding:10px;"><input type="email" name="correo" value="<%= tr.correo %>" style="padding:5px; width:100%;"></td>
              <td style="padding:10px; display:flex; gap:5px;">
                <button type="submit" class="btn-sm" style="background:#2563eb; color:#fff;">Guardar</button>
            </form>
            <form action="/admin/transportadoras/eliminar" method="POST" style="display:inline;">
              <input type="hidden" name="id_transportadora" value="<%= tr.id_transportadora %>">
              <button type="submit" class="btn-danger-sm">X</button>
            </form>
              </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>