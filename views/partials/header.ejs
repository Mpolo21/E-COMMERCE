<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'E-commerce Ropa Masculina' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="main-header">
    <div class="container nav-container">
      <h1><a href="/catalogo">PIJIC E-commerce Ropa</a></h1>
      <nav>
        <% if (usuarioActual) { %>
          <span>Hola, <strong><%= usuarioActual.nombre %></strong> (<%= usuarioActual.nombre_rol %>)</span>
          <% if (usuarioActual.nombre_rol === 'Cliente') { %>
            <a href="/catalogo">Catálogo</a>
            <a href="/carrito">Carrito (<%= carritoCantidad %>)</a>
            <a href="/cuenta/pedidos">Mis Pedidos</a>
          <% } else if (usuarioActual.nombre_rol === 'Administrador') { %>
            <a href="/admin/dashboard">Panel Admin</a>
          <% } else if (usuarioActual.nombre_rol === 'Proveedor') { %>
            <a href="/proveedor/consultas">Consultas Proveedor</a>
          <% } %>
          <a href="/auth/logout" class="btn-logout">Cerrar Sesión</a>
        <% } else { %>
          <a href="/auth/login">Iniciar Sesión</a>
          <a href="/auth/register">Registrarse</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container main-content">
    <% if (mensajeExito) { %>
      <div class="alert alert-success"><%= mensajeExito %></div>
    <% } %>
    <% if (mensajeError) { %>
      <div class="alert alert-danger"><%= mensajeError %></div>
    <% } %>