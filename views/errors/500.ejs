<%- include('../partials/header') %>
<div class="error-container">
  <span class="badge badge-danger">Error 500</span>
  <h2>Error interno del servidor</h2>
  <p>Ocurrió un inconveniente inesperado al procesar tu solicitud. Intenta nuevamente.</p>
  <a href="<%= typeof rutaRetorno !== 'undefined' ? rutaRetorno : rutaInicioRol %>" class="btn-primary" style="display:inline-block; width:auto; text-decoration:none; margin-top:15px;">
    <%= usuarioActual ? 'Volver a mi panel' : 'Ir a Iniciar Sesión' %>
  </a>
</div>
<%- include('../partials/footer') %>